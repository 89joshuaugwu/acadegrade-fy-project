  ],
  "requiredAverageForTarget": [
    { "input": { "currentCgpa": 3.4, "completedUnits": 30, "targetCgpa": 3.5, "remainingUnits": 18 }, "expected": 3.6666666666666665 },
    { "input": { "currentCgpa": 4, "completedUnits": 60, "targetCgpa": 4.5, "remainingUnits": 36 }, "expected": 5.333333333333333, "note": "above 5.00 means the target is out of reach; callers decide how to show it" },
    { "input": { "currentCgpa": 0, "completedUnits": 0, "targetCgpa": 3, "remainingUnits": 18 }, "expected": 3 },
    { "input": { "currentCgpa": 4, "completedUnits": 90, "targetCgpa": 3.5, "remainingUnits": 30 }, "expected": 2 },
    { "input": { "currentCgpa": 4.5, "completedUnits": 100, "targetCgpa": 3, "remainingUnits": 20 }, "expected": -4.5, "note": "negative is returned unchanged; callers clamp for display" },
    { "input": { "currentCgpa": 3.4, "completedUnits": 30, "targetCgpa": 3.5, "remainingUnits": 0 }, "expected": null },
    { "input": { "currentCgpa": 3.4, "completedUnits": 30, "targetCgpa": 3.5, "remainingUnits": -6 }, "expected": null }
  ],
  "maxReachableCgpa": [
    { "input": { "currentCgpa": 3.4, "completedUnits": 30, "remainingUnits": 18 }, "expected": 4 },
    { "input": { "currentCgpa": 4, "completedUnits": 60, "remainingUnits": 36 }, "expected": 4.375 },
    { "input": { "currentCgpa": 3.2, "completedUnits": 100, "remainingUnits": 0 }, "expected": 3.2 },
    { "input": { "currentCgpa": 3.2, "completedUnits": 100, "remainingUnits": -10 }, "expected": 3.2 },
    { "input": { "currentCgpa": 0, "completedUnits": 0, "remainingUnits": 18 }, "expected": 5 },
    { "input": { "currentCgpa": 0, "completedUnits": 0, "remainingUnits": 0 }, "expected": 0 }
  ],
  "isCarryOver": [
    { "name": "failed by scores", "course": { "code": "CSC 201", "caScore": 10, "examScore": 25 }, "expected": true },
    { "name": "fractional fail below 40", "course": { "code": "CSC 202", "caScore": 19.5, "examScore": 20 }, "expected": true },
    { "name": "D is a pass", "course": { "code": "CSC 203", "caScore": 20, "examScore": 25 }, "expected": false },
    { "name": "E is a pass", "course": { "code": "CSC 204", "caScore": 15, "examScore": 25 }, "expected": false },
    { "name": "stored total only, failing", "course": { "code": "CSC 205", "caScore": null, "examScore": null, "totalScore": 35, "grade": null }, "expected": true },
    { "name": "stored total only, passing", "course": { "code": "CSC 206", "caScore": null, "examScore": null, "totalScore": 74, "grade": null }, "expected": false },
    { "name": "letter grade F only", "course": { "code": "CSC 207", "caScore": null, "examScore": null, "grade": "F" }, "expected": true },
    { "name": "letter grade E only", "course": { "code": "CSC 208", "caScore": null, "examScore": null, "grade": "E" }, "expected": false },
    { "name": "awaiting result is not a carry-over", "course": { "code": "CSC 209", "caScore": null, "examScore": null, "grade": "F", "isAR": true }, "expected": false },
    { "name": "pending import is not a carry-over", "course": { "code": "CSC 210", "caScore": null, "examScore": null, "grade": null, "pending": true }, "expected": false },
    { "name": "pending import with a placeholder F is not a carry-over", "course": { "code": "CSC 211", "caScore": null, "examScore": null, "totalScore": null, "grade": "F", "gradePoint": 0, "pending": true }, "expected": false },
    { "name": "no score and no grade is unknown, not a carry-over", "course": { "code": "CSC 212", "caScore": null, "examScore": null, "totalScore": null, "grade": null }, "expected": false },
    { "name": "one score missing and no grade is unknown", "course": { "code": "CSC 213", "caScore": 10, "examScore": null }, "expected": false }
  ],
  "outstandingCarryOvers": [
    {
      "name": "a failed course passed later is cleared, matching normalised codes",
      "semesters": [
        { "courses": [{ "code": "MTH 101", "caScore": 10, "examScore": 20 }] },
        { "courses": [{ "code": "mth101", "caScore": 20, "examScore": 45 }] }
      ],
      "expected": []
    },
    {
      "name": "a failed course never retaken stays outstanding",
      "semesters": [
        { "courses": [
          { "code": "CSC 201", "caScore": 10, "examScore": 25 },
          { "code": "CSC 202", "caScore": 25, "examScore": 50 }
        ] }
      ],
      "expected": ["CSC201"]
    },
    {
      "name": "retaken and failed again is listed once",
      "semesters": [
        { "courses": [{ "code": "PHY 101", "caScore": 5, "examScore": 20 }] },
        { "courses": [{ "code": "PHY101", "caScore": 10, "examScore": 20 }] }
      ],
      "expected": ["PHY101"]
    },
    {
      "name": "a later awaiting result does not clear it",
      "semesters": [
        { "courses": [{ "code": "GST 111", "caScore": 10, "examScore": 20 }] },
        { "courses": [{ "code": "GST 111", "caScore": null, "examScore": null, "isAR": true }] }
      ],
      "expected": ["GST111"]
    },
    {
      "name": "a later pending import does not clear it",
      "semesters": [
        { "courses": [{ "code": "CHM 101", "caScore": 10, "examScore": 20 }] },
        { "courses": [{ "code": "CHM 101", "caScore": null, "examScore": null, "grade": null, "pending": true }] }
      ],
      "expected": ["CHM101"]
    },
    {
      "name": "a later row with no score or grade does not clear it",
      "semesters": [
        { "courses": [{ "code": "BIO 101", "caScore": 10, "examScore": 20 }] },
        { "courses": [{ "code": "BIO 101", "caScore": null, "examScore": null, "grade": null }] }
      ],
      "expected": ["BIO101"]
    },
    {
      "name": "a letter-grade pass clears a letter-grade fail",
      "semesters": [
        { "courses": [{ "code": "ENG 101", "caScore": null, "examScore": null, "grade": "F" }] },
        { "courses": [{ "code": "ENG 101", "caScore": null, "examScore": null, "grade": "C" }] }
      ],
      "expected": []
    },
    {
      "name": "a fail after an earlier pass is outstanding",
      "semesters": [
        { "courses": [{ "code": "STA 201", "caScore": 20, "examScore": 45 }] },
        { "courses": [{ "code": "STA 201", "caScore": 10, "examScore": 20 }] }
      ],
      "expected": ["STA201"]
    },
    {
      "name": "order follows the first failure of each outstanding course",
      "semesters": [
        { "courses": [
          { "code": "CSC 301", "caScore": 10, "examScore": 20 },
          { "code": "CSC 302", "caScore": 10, "examScore": 20 }
        ] },
        { "courses": [{ "code": "CSC 301", "caScore": 25, "examScore": 40 }] },
        { "courses": [{ "code": "CSC 301", "caScore": 10, "examScore": 20 }] }
      ],
      "expected": ["CSC302", "CSC301"]
    },
    {
      "name": "whitespace and case variants are the same course",
      "semesters": [
        { "courses": [{ "code": " csc  205 ", "caScore": 10, "examScore": 20 }] },
        { "courses": [{ "code": "Csc205", "caScore": 25, "examScore": 40 }] }
      ],
      "expected": []
    },
    {
      "name": "blank codes are ignored",
      "semesters": [
        { "courses": [{ "code": "   ", "caScore": 10, "examScore": 20 }] }
      ],
      "expected": []
    },
    {
      "name": "no semesters",
      "semesters": [],
      "expected": []
    }
  ],
  "endToEnd": [
    {
      "name": "539 grade points over 120 units shows 4.49 and is 2:1, not Fail",
      "summaries": [
        { "gpa": 4.5, "pi": 4.1, "creditLoaded": 40 },
        { "gpa": 4.4875, "pi": 4, "creditLoaded": 80 }
      ],
      "expected": { "cgpa": 4.491666666666667, "display": "4.49", "shortLabel": "2:1" }
    },
    {
      "name": "awaiting results never drag the CGPA down",
      "courseSemesters": [
        { "courses": [
          { "code": "CSC 301", "title": "Algorithms", "units": 3, "caScore": 25, "examScore": 50 },
          { "code": "CSC 399", "title": "Industrial Training", "units": 6, "caScore": null, "examScore": null, "isAR": true }
        ] },
        { "courses": [
          { "code": "CSC 302", "title": "Automata", "units": 3, "caScore": 20, "examScore": 30 }
        ] }
      ],
      "expected": { "cgpa": 4, "display": "4.00", "shortLabel": "2:1" }
