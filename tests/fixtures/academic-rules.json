{
  "schemaVersion": 1,
  "about": "Shared AcadeGrade academic-rules cases. Byte-identical copies live at acadegrade-web/tests/fixtures/academic-rules.json and acadegrade-mobile/tests/fixtures/academic-rules.json. Both test suites pin its sha256 (LF line endings), so edit both copies and both hashes together. Special inputs: the strings \"NaN\" and \"undefined\" stand for those JavaScript values.",
  "gradeFromScore": [
    { "score": 100, "grade": "A", "gradePoint": 5 },
    { "score": 70, "grade": "A", "gradePoint": 5 },
    { "score": 69.99999999999999, "grade": "A", "gradePoint": 5, "note": "float noise from summing CA and exam is not a lower grade" },
    { "score": 69.5, "grade": "B", "gradePoint": 4, "note": "fractional totals between bands take the lower band, never F" },
    { "score": 69, "grade": "B", "gradePoint": 4 },
    { "score": 60, "grade": "B", "gradePoint": 4 },
    { "score": 59.5, "grade": "C", "gradePoint": 3 },
    { "score": 59, "grade": "C", "gradePoint": 3 },
    { "score": 50, "grade": "C", "gradePoint": 3 },
    { "score": 49, "grade": "D", "gradePoint": 2 },
    { "score": 45, "grade": "D", "gradePoint": 2 },
    { "score": 44.5, "grade": "E", "gradePoint": 1 },
    { "score": 44, "grade": "E", "gradePoint": 1 },
    { "score": 40, "grade": "E", "gradePoint": 1 },
    { "score": 39.9, "grade": "F", "gradePoint": 0 },
    { "score": 39, "grade": "F", "gradePoint": 0 },
    { "score": 0, "grade": "F", "gradePoint": 0 },
    { "score": -5, "grade": "F", "gradePoint": 0 },
    { "score": "NaN", "grade": "F", "gradePoint": 0 }
  ],
  "courseMetrics": [
    {
      "name": "CA plus exam gives the grade and a continuous PI point",
      "input": { "code": "CSC 425", "title": "Allocation Management", "units": 2, "caScore": 26, "examScore": 28 },
      "expected": { "totalScore": 54, "grade": "C", "gradePoint": 3, "piPoint": 2.7, "estimated": false },
      "absentKeys": ["isAR", "pending"]
    },
    {
      "name": "full marks",
      "input": { "code": "CSC 401", "title": "Compilers", "units": 3, "caScore": 30, "examScore": 70 },
      "expected": { "totalScore": 100, "grade": "A", "gradePoint": 5, "piPoint": 5, "estimated": false }
    },
    {
      "name": "zero scores are a real F",
      "input": { "code": "CSC 455", "title": "Networks", "units": 3, "caScore": 0, "examScore": 0 },
      "expected": { "totalScore": 0, "grade": "F", "gradePoint": 0, "piPoint": 0, "estimated": false }
    },
    {
      "name": "fractional total between bands",
      "input": { "code": "CSC 411", "title": "Graphics", "units": 2, "caScore": 19.5, "examScore": 50 },
      "expected": { "totalScore": 69.5, "grade": "B", "gradePoint": 4, "piPoint": 3.475, "estimated": false }
    },
    {
      "name": "letter grade only is estimated with PI equal to the grade point",
      "input": { "code": "CSC 463", "title": "Software Engineering", "units": 2, "caScore": null, "examScore": null, "grade": "B" },
      "expected": { "totalScore": null, "grade": "B", "gradePoint": 4, "piPoint": 4, "estimated": true }
    },
    {
      "name": "no score and no grade",
      "input": { "code": "CSC 470", "title": "Unknown", "units": 2, "caScore": null, "examScore": null },
      "expected": { "totalScore": null, "grade": "F", "gradePoint": 0, "piPoint": 0, "estimated": false }
    },
    {
      "name": "one score missing does not invent a total",
      "input": { "code": "CSC 471", "title": "Partial", "units": 2, "caScore": 20, "examScore": null },
      "expected": { "totalScore": null, "grade": "F", "gradePoint": 0, "piPoint": 0, "estimated": false }
    },
    {
      "name": "awaiting result keeps its flag so GPA can skip it",
      "input": { "code": "CSC 499", "title": "Project", "units": 6, "caScore": null, "examScore": null, "isAR": true },
      "expected": { "totalScore": null, "grade": "F", "gradePoint": 0, "piPoint": 0, "estimated": false, "isAR": true }
    },
    {
      "name": "pending share-code import keeps its flag so GPA can skip it",
      "input": { "code": "CSC 498", "title": "Seminar", "units": 2, "caScore": null, "examScore": null, "pending": true },
      "expected": { "totalScore": null, "grade": "F", "gradePoint": 0, "piPoint": 0, "estimated": false, "pending": true }
    }
  ],
  "semesterGpa": [
    {
      "name": "awaiting-result and pending rows do not count",
      "courses": [
        { "code": "CSC 401", "title": "Compilers", "units": 3, "caScore": 26, "examScore": 50 },
        { "code": "CSC 402", "title": "Databases", "units": 2, "caScore": 20, "examScore": 35 },
        { "code": "CSC 499", "title": "Project", "units": 6, "caScore": null, "examScore": null, "isAR": true },
        { "code": "CSC 410", "title": "Imported", "units": 3, "caScore": null, "examScore": null, "pending": true }
      ],
      "expected": {
        "gpa": 4.2, "pi": 3.38, "creditLoaded": 5, "courseCount": 4,
        "gradeDistribution": { "A": 1, "B": 0, "C": 1, "D": 0, "E": 0, "F": 0 }
      }
    },
    {
      "name": "a semester of only awaiting results has no GPA yet",
      "courses": [
        { "code": "CSC 499", "title": "Project", "units": 6, "caScore": null, "examScore": null, "isAR": true }
      ],
      "expected": {
        "gpa": 0, "pi": 0, "creditLoaded": 0, "courseCount": 1,
        "gradeDistribution": { "A": 0, "B": 0, "C": 0, "D": 0, "E": 0, "F": 0 }
      }
    },
    {
      "name": "no courses",
      "courses": [],
      "expected": {
        "gpa": 0, "pi": 0, "creditLoaded": 0, "courseCount": 0,
        "gradeDistribution": { "A": 0, "B": 0, "C": 0, "D": 0, "E": 0, "F": 0 }
      }
    },
    {
      "name": "letter-grade rows count with their grade point",
      "courses": [
        { "code": "CSC 463", "title": "Software Engineering", "units": 3, "caScore": null, "examScore": null, "grade": "B" },
        { "code": "CSC 464", "title": "Testing", "units": 2, "caScore": 30, "examScore": 45 }
      ],
      "expected": {
        "gpa": 4.4, "pi": 3.9, "creditLoaded": 5, "courseCount": 2,
        "gradeDistribution": { "A": 1, "B": 1, "C": 0, "D": 0, "E": 0, "F": 0 }
      }
    }
  ],
  "cumulativeCgpa": [
    {
      "name": "weights each semester by its credit load",
      "semesters": [
        { "gpa": 4, "pi": 4.2, "creditLoaded": 12 },
        { "gpa": 3, "pi": 3.1, "creditLoaded": 18 }
      ],
      "expected": { "cgpa": 3.4, "pi": 3.54, "totalCredits": 30 }
    },
    {
      "name": "graded credits count whether or not the semester is marked complete",
      "semesters": [
        { "gpa": 4, "pi": 4.2, "creditLoaded": 12, "isComplete": true },
        { "gpa": 3, "pi": 3.1, "creditLoaded": 18, "isComplete": false }
      ],
      "expected": { "cgpa": 3.4, "pi": 3.54, "totalCredits": 30 }
    },
    {
      "name": "a semester with no graded credits is ignored",
      "semesters": [
        { "gpa": 5, "pi": 5, "creditLoaded": 0 },
        { "gpa": 2, "pi": 2.5, "creditLoaded": 10 }
      ],
      "expected": { "cgpa": 2, "pi": 2.5, "totalCredits": 10 }
    },
    {
      "name": "no semesters",
      "semesters": [],
      "expected": { "cgpa": 0, "pi": 0, "totalCredits": 0 }
    }
  ],
  "roundCgpa": [
    { "input": 4.4917, "expected": 4.49 },
    { "input": 4.495, "expected": 4.5 },
    { "input": 4.4949, "expected": 4.49 },
    { "input": 3.4999, "expected": 3.5 },
    { "input": 1, "expected": 1 },
    { "input": 0.995, "expected": 1 },
    { "input": 0.994, "expected": 0.99 },
    { "input": 0, "expected": 0 },
    { "input": 5, "expected": 5 },
    { "input": 4.491666666666667, "expected": 4.49, "note": "539 grade points over 120 units" },
    { "input": 2.385, "expected": 2.39, "note": "float-safe: (x + Number.EPSILON) * 100 gives 2.38" },
    { "input": 4.395, "expected": 4.4, "note": "float-safe: (x + Number.EPSILON) * 100 gives 4.39" },
    { "input": 1.005, "expected": 1.01 },
    { "input": 2.675, "expected": 2.68 },
    { "input": "NaN", "expected": 0 },
    { "input": null, "expected": 0 },
    { "input": "undefined", "expected": 0 }
  ],
  "formatCgpa": [
    { "input": 4.4917, "expected": "4.49" },
    { "input": 4.495, "expected": "4.50" },
    { "input": 3.4999, "expected": "3.50" },
    { "input": 0.995, "expected": "1.00", "note": "toFixed(2) shows 0.99 here while the class is Pass" },
    { "input": 2.675, "expected": "2.68", "note": "toFixed(2) shows 2.67" },
    { "input": 5, "expected": "5.00" },
    { "input": 0, "expected": "0.00" },
    { "input": "NaN", "expected": "0.00" },
    { "input": null, "expected": "0.00" }
  ],
