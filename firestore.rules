rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
             (request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admins).data.emails);
    }

    // Age and consent answers are written only by server routes
    // (/api/user/age, /api/user/requirements, registration finalize).
    // lastActiveAt: lib/user/activity.ts (admin "Active this week").
    // fcmTopics, fcmTopicsTokensHash: lib/notifications/topics.ts (announcement topics).
    function serverOwnedUserFields() {
      return ['ageStatus', 'ageDeclaredAt', 'ageUpgradedAt', 'consents', 'lastActiveAt', 'fcmTopics', 'fcmTopicsTokensHash'];
    }

    // True unless the admin has switched this feature off in Settings > Access
    // (config/settings.disabledFeatures). A missing settings document means "all on",
    // so a fresh project is never locked out. Both reads hit the same document, billed once.
    function platformFeatureEnabled(feature) {
      return !exists(/databases/$(database)/documents/config/settings)
        || !(feature in get(/databases/$(database)/documents/config/settings).data.get('disabledFeatures', []));
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) || isAdmin())
        && !request.resource.data.keys().hasAny(serverOwnedUserFields());
      // Other profile edits (tour flags, preferences, tokens, avatar) are unchanged.
      allow update: if (isOwner(userId) || isAdmin())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOwnedUserFields());
      
      // Subcollection: Semesters
      match /semesters/{semesterId} {
        allow read, write: if isOwner(userId) || isAdmin();
        
        // Subcollection: Courses (within a semester)
        match /courses/{courseId} {
          allow read, write: if isOwner(userId) || isAdmin();
        }
      }
    }
    
    // 2. Analytics Collection
    match /analytics/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // 3. Notifications Collection
    match /notifications/{userId}/items/{notifId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // Announcements (Admin > Settings > Announcements). Signed-in students read
    // published ones only (queries must filter status == 'published'); writes go
    // through /api/admin/announcements.
    match /announcements/{announcementId} {
      allow get, list: if isAuthenticated() && resource.data.status == 'published';
      allow write: if false;
    }

    // 4. Configuration & Admins
    match /config/settings {
      allow read: if true; // All users need to read announcement banners, etc.
      allow write: if isAdmin(); 
    }
    
    // Terms/Privacy versions. Admins change them through /api/admin/legal.
    match /config/legal {
      allow read: if true;
      allow write: if false;
    }

    match /config/admins {
      allow read: if isAdmin(); // Only admins can read the admin list
      allow write: if false; // Only manageable directly via Firebase Console
    }
    
    // 5. Course Catalog
    match /courseCatalog/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); 
    }
    
    // 6. Share Codes
    match /shareCodes/{codeId} {
      // A signed-in user can fetch one code they know; nobody can list every code.
      allow get: if isAuthenticated();
      // New codes stop while the admin has switched "share_code" off (admins always may).
      allow create: if isAdmin() || (isAuthenticated() && platformFeatureEnabled('share_code'));
      allow update: if (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['useCount'])) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // 7. Shared Transcripts
    match /shared_transcripts/{docId} {
      allow read, delete: if isOwner(resource.data.uid);
    }

    // Server-only abuse-protection counters. Firebase Admin bypasses rules;
    // no browser or mobile client may inspect or modify its own quota state.
    match /_api_rate_limits/{docId} {
      allow read, write: if false;
    }

    // Reward grants, replay tombstones and daily budgets are server-owned.
    // Even admins/owners must use authenticated server routes, not client SDKs.
    match /_reward_sessions/{document=**} {
      allow read, write: if false;
    }
    match /_reward_transactions/{document=**} {
      allow read, write: if false;
    }
    match /_reward_daily/{document=**} {
      allow read, write: if false;
    }

    // Coin wallets, the append-only ledger and spend idempotency records are
    // server-owned. Clients never read or write balances directly.
    match /_coin_wallets/{document=**} {
      allow read, write: if false;
    }
    match /_coin_ledger/{document=**} {
      allow read, write: if false;
    }
    match /_coin_requests/{document=**} {
      allow read, write: if false;
    }

    // Registration tickets and normalized matric reservations are created and
    // consumed only by Firebase Admin inside server routes.
    match /_registration_tickets/{docId} {
      allow read, write: if false;
    }

    match /_matric_numbers/{docId} {
      allow read, write: if false;
    }

    // AI provider credentials, routing, and audit records are available only
    // through Firebase Admin in server routes. Client SDK callers are denied.
    match /_ai_runtime/{document=**} {
      allow read, write: if false;
    }

    match /_ai_secrets/{document=**} {
      allow read, write: if false;
    }

    match /_ai_audit/{document=**} {
      allow read, write: if false;
    }

    // Admin audit trail (lib/api/admin-audit.ts) and AI answer feedback/reports
    // (/api/ai/report). Read only through admin server routes.
    match /_admin_audit/{document=**} {
      allow read, write: if false;
    }

    match /_ai_feedback/{document=**} {
      allow read, write: if false;
    }

    // Result of the last "Verify login" for each email account (login address and source only).
    match /_email_status/{document=**} {
      allow read, write: if false;
    }

    // Terms and Privacy drafts and published versions (Admin > Legal documents).
    // The public pages read them through the server, never from a browser or the app.
    match /legal_documents/{document=**} {
      allow read, write: if false;
    }

    // Record of each daily clean-up run (/api/cron/daily). Read through the admin API only.
    match /_cron_runs/{document=**} {
      allow read, write: if false;
    }

    // Daily admin metrics roll-up (lib/admin/metrics.ts) and cron job cursors.
    // Aggregates only; read through /api/admin/stats.
    match /admin_metrics/{document=**} {
      allow read, write: if false;
    }

    match /_cron_state/{document=**} {
      allow read, write: if false;
    }

    // Each admin's monthly goodwill-coin allowance (Admin > Users > grant coins).
    match /_admin_grants/{document=**} {
      allow read, write: if false;
    }

    // Support requests. Students use /api/support/tickets; admins use /api/admin/support.
    match /support_tickets/{document=**} {
      allow read, write: if false;
    }

    // Gmail App Passwords are encrypted and managed only by server routes.
    match /_email_secrets/{document=**} {
      allow read, write: if false;
    }

    // Academic catalog suggestions are moderated through server routes only.
    match /_academic_catalog_suggestions/{document=**} {
      allow read, write: if false;
    }
  }
}
