rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
             (request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admins).data.emails);
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      // Subcollection: Semesters
      match /semesters/{semesterId} {
        allow read, write: if isOwner(userId) || isAdmin();
        
        // Subcollection: Courses (within a semester)
        match /courses/{courseId} {
          allow read, write: if isOwner(userId) || isAdmin();
        }
      }
    }
    
    // 2. Analytics Collection
    match /analytics/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // 3. Notifications Collection
    match /notifications/{userId}/items/{notifId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // 4. Configuration & Admins
    match /config/settings {
      allow read: if true; // All users need to read announcement banners, etc.
      allow write: if isAdmin(); 
    }
    
    match /config/admins {
      allow read: if isAdmin(); // Only admins can read the admin list
      allow write: if false; // Only manageable directly via Firebase Console
    }
    
    // 5. Course Catalog
    match /courseCatalog/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); 
    }
    
    // 6. Share Codes
    match /shareCodes/{codeId} {
      allow read: if isAuthenticated() || isAdmin();
      allow create: if isAuthenticated() || isAdmin();
      allow update: if (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['useCount'])) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // 7. Shared Transcripts
    match /shared_transcripts/{docId} {
      allow read, delete: if isOwner(resource.data.uid);
    }

    // Server-only abuse-protection counters. Firebase Admin bypasses rules;
    // no browser or mobile client may inspect or modify its own quota state.
    match /_api_rate_limits/{docId} {
      allow read, write: if false;
    }

    // Reward grants, replay tombstones and daily budgets are server-owned.
    // Even admins/owners must use authenticated server routes, not client SDKs.
    match /_reward_sessions/{document=**} {
      allow read, write: if false;
    }
    match /_reward_transactions/{document=**} {
      allow read, write: if false;
    }
    match /_reward_daily/{document=**} {
      allow read, write: if false;
    }

    // Registration tickets and normalized matric reservations are created and
    // consumed only by Firebase Admin inside server routes.
    match /_registration_tickets/{docId} {
      allow read, write: if false;
    }

    match /_matric_numbers/{docId} {
      allow read, write: if false;
    }

    // AI provider credentials, routing, and audit records are available only
    // through Firebase Admin in server routes. Client SDK callers are denied.
    match /_ai_runtime/{document=**} {
      allow read, write: if false;
    }

    match /_ai_secrets/{document=**} {
      allow read, write: if false;
    }

    match /_ai_audit/{document=**} {
      allow read, write: if false;
    }

    // Gmail App Passwords are encrypted and managed only by server routes.
    match /_email_secrets/{document=**} {
      allow read, write: if false;
    }

    // Academic catalog suggestions are moderated through server routes only.
    match /_academic_catalog_suggestions/{document=**} {
      allow read, write: if false;
    }
  }
}
