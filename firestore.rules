rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
             (request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admins).data.emails);
    }

    // Age and consent answers are written only by server routes
    // (/api/user/age, /api/user/requirements, registration finalize).
    // lastActiveAt: lib/user/activity.ts (admin "Active this week").
    // fcmTopics, fcmTopicsTokensHash: lib/notifications/topics.ts (announcement topics).
    function serverOwnedUserFields() {
      return ['ageStatus', 'ageDeclaredAt', 'ageUpgradedAt', 'consents', 'lastActiveAt', 'fcmTopics', 'fcmTopicsTokensHash'];
    }

    // True unless the admin has switched this feature off in Settings > Access
    // (config/settings.disabledFeatures). A missing settings document means "all on",
    // so a fresh project is never locked out. Both reads hit the same document, billed once.
    function platformFeatureEnabled(feature) {
      return !exists(/databases/$(database)/documents/config/settings)
        || !(feature in get(/databases/$(database)/documents/config/settings).data.get('disabledFeatures', []));
    }

    // users/{uid}.gradingScale (optional; absent means the 5-point scale).
    // Same limits as validateCustomScale in lib/cgpa/academicRules.ts; the app
    // checks the details, the rules keep the stored size bounded.
    function validGradingScale(gs) {
      return gs is map
        && gs.keys().hasAll(['id'])
        && gs.keys().hasOnly(['id', 'custom', 'nceClasses'])
        && gs.id in ['ng5', 'ng5-noE', 'nbte4', 'nce5', 'custom']
        && (gs.id != 'custom' || 'custom' in gs)
        && (!('custom' in gs) || validCustomScale(gs.custom))
        && (!('nceClasses' in gs) || validNceClasses(gs.nceClasses));
    }

    function validCustomScale(c) {
      return c is map
        && c.keys().hasOnly(['name', 'maxPoint', 'bands', 'classes'])
        && c.bands is list && c.bands.size() >= 2 && c.bands.size() <= 12
        && c.classes is list && c.classes.size() >= 1 && c.classes.size() <= 8
        && c.maxPoint is number && c.maxPoint >= 1 && c.maxPoint <= 10
        && (!('name' in c) || (c.name is string && c.name.size() <= 40));
    }

    function validNceBoundary(value) {
      return value is number && value > 0 && value <= 5;
    }

    function validNceClasses(n) {
      return n is map
        && n.keys().hasOnly(['distinction', 'credit', 'merit', 'pass'])
        && (!('distinction' in n) || validNceBoundary(n.distinction))
        && (!('credit' in n) || validNceBoundary(n.credit))
        && (!('merit' in n) || validNceBoundary(n.merit))
        && (!('pass' in n) || validNceBoundary(n.pass));
    }

    // Phase 2 record types (GRADING_AND_PROFILES_PLAN.md). users/{uid}.recordType
    // is optional; absent means tertiary, so existing accounts are unchanged.
    // The O-level and admission limits match lib/records/olevelRules.ts and
    // lib/records/admissionRules.ts; the app checks the details, the rules keep
    // the stored shape bounded.
    function validRecordType(value) {
      return value in ['tertiary', 'olevel', 'admission'];
    }

    function shortText(value, max) {
      return value is string && value.size() >= 1 && value.size() <= max;
    }

    function validOlevelGrade(g) {
      return g in ['A1', 'B2', 'B3', 'C4', 'C5', 'C6', 'D7', 'E8', 'F9', 'AR'];
    }

    function validOlevelSubject(s) {
      return s is map
        && s.keys().hasAll(['subjectId', 'name', 'grade'])
        && s.keys().hasOnly(['subjectId', 'name', 'grade'])
        && shortText(s.subjectId, 80) && shortText(s.name, 60)
        && validOlevelGrade(s.grade);
    }

    function validOlevelSubjectAt(list, i) {
      return list.size() <= i || validOlevelSubject(list[i]);
    }

    function validOlevelSitting(s) {
      return s is map
        && s.keys().hasAll(['id', 'exam', 'year', 'subjects'])
        && s.keys().hasOnly(['id', 'exam', 'year', 'subjects'])
        && shortText(s.id, 40)
        && s.exam in ['waec', 'waec-gce', 'neco', 'neco-gce', 'nabteb']
        && s.year is int && s.year >= 1988 && s.year <= 2100
        && s.subjects is list && s.subjects.size() <= 9
        && validOlevelSubjectAt(s.subjects, 0) && validOlevelSubjectAt(s.subjects, 1) && validOlevelSubjectAt(s.subjects, 2)
        && validOlevelSubjectAt(s.subjects, 3) && validOlevelSubjectAt(s.subjects, 4) && validOlevelSubjectAt(s.subjects, 5)
        && validOlevelSubjectAt(s.subjects, 6) && validOlevelSubjectAt(s.subjects, 7) && validOlevelSubjectAt(s.subjects, 8);
    }

    function validOlevelSittingAt(list, i) {
      return list.size() <= i || validOlevelSitting(list[i]);
    }

    function validOlevelRecord(d) {
      return d.keys().hasAll(['sittings'])
        && d.keys().hasOnly(['schemaVersion', 'sittings', 'targetCourse', 'updatedAt'])
        && (!('schemaVersion' in d) || d.schemaVersion == 1)
        && (!('updatedAt' in d) || d.updatedAt is timestamp)
        && d.sittings is list && d.sittings.size() <= 2
        && validOlevelSittingAt(d.sittings, 0) && validOlevelSittingAt(d.sittings, 1)
        && (!('targetCourse' in d) || (d.targetCourse is map
          && d.targetCourse.keys().hasOnly(['name', 'required'])
          && shortText(d.targetCourse.name, 80)
          && d.targetCourse.required is list && d.targetCourse.required.size() <= 6));
    }

    function validAdmissionGrade(g) {
      return g is map
        && g.keys().hasAll(['subjectId', 'grade'])
        && g.keys().hasOnly(['subjectId', 'grade'])
        && shortText(g.subjectId, 80)
        && validOlevelGrade(g.grade);
    }

    function validAdmissionGradeAt(list, i) {
      return list.size() <= i || validAdmissionGrade(list[i]);
    }

    function validAdmissionRecord(d) {
      return d.keys().hasAll(['formula', 'olevelSource'])
        && d.keys().hasOnly(['schemaVersion', 'utme', 'postUtme', 'formula', 'weights', 'pointTable', 'customPoints', 'olevelSource', 'olevelGrades', 'school', 'course', 'target', 'updatedAt'])
        && (!('schemaVersion' in d) || d.schemaVersion == 1)
        && (!('updatedAt' in d) || d.updatedAt is timestamp)
        && d.formula in ['utme-post', 'utme-olevel-post', 'custom']
        && d.olevelSource in ['record', 'manual']
        && (!('utme' in d) || (d.utme is map
          && d.utme.keys().hasAll(['score'])
          && d.utme.keys().hasOnly(['score', 'year'])
          && d.utme.score is int && d.utme.score >= 0 && d.utme.score <= 400
          && (!('year' in d.utme) || (d.utme.year is int && d.utme.year >= 1978 && d.utme.year <= 2100))))
        && (!('postUtme' in d) || (d.postUtme is map
          && d.postUtme.keys().hasAll(['max'])
          && d.postUtme.keys().hasOnly(['score', 'max'])
          && d.postUtme.max is int && d.postUtme.max >= 1 && d.postUtme.max <= 400
          && (!('score' in d.postUtme) || (d.postUtme.score is number && d.postUtme.score >= 0 && d.postUtme.score <= d.postUtme.max))))
        && (!('weights' in d) || (d.weights is map
          && d.weights.keys().hasAll(['utme', 'olevel', 'postUtme'])
          && d.weights.keys().hasOnly(['utme', 'olevel', 'postUtme'])
          && d.weights.utme is number && d.weights.olevel is number && d.weights.postUtme is number))
        && (!('pointTable' in d) || d.pointTable in ['four-to-two', 'six-to-one', 'ten-to-five', 'custom'])
        && (!('customPoints' in d) || (d.customPoints is map
          && d.customPoints.keys().hasOnly(['A1', 'B2', 'B3', 'C4', 'C5', 'C6'])))
        && (!('olevelGrades' in d) || (d.olevelGrades is list && d.olevelGrades.size() <= 5
          && validAdmissionGradeAt(d.olevelGrades, 0) && validAdmissionGradeAt(d.olevelGrades, 1) && validAdmissionGradeAt(d.olevelGrades, 2)
          && validAdmissionGradeAt(d.olevelGrades, 3) && validAdmissionGradeAt(d.olevelGrades, 4)))
        && (!('school' in d) || (d.school is string && d.school.size() <= 80))
        && (!('course' in d) || (d.course is string && d.course.size() <= 80))
        && (!('target' in d) || (d.target is number && d.target >= 0 && d.target <= 100));
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) || isAdmin())
        && !request.resource.data.keys().hasAny(serverOwnedUserFields())
        && (!('recordType' in request.resource.data) || validRecordType(request.resource.data.recordType))
        && (!('gradingScale' in request.resource.data) || validGradingScale(request.resource.data.gradingScale));
      // Other profile edits (tour flags, preferences, tokens, avatar) are unchanged.
      allow update: if (isOwner(userId) || isAdmin())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOwnedUserFields())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['recordType'])
          || !('recordType' in request.resource.data)
          || validRecordType(request.resource.data.recordType))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['gradingScale'])
          || !('gradingScale' in request.resource.data)
          || validGradingScale(request.resource.data.gradingScale));
      
      // Subcollection: Semesters
      match /semesters/{semesterId} {
        allow read, write: if isOwner(userId) || isAdmin();
        
        // Subcollection: Courses (within a semester)
        match /courses/{courseId} {
          allow read, write: if isOwner(userId) || isAdmin();
        }
      }

      // Subcollection: Timetables (T1). Written by the student's own app or browser.
      match /timetables/{timetableId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      // Phase 2: WAEC/NECO sittings, one document ('current'). Owner writes, admin reads.
      match /olevel/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && docId == 'current' && validOlevelRecord(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // Phase 2: JAMB UTME, post-UTME and aggregate settings, one document ('current').
      match /admission/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && docId == 'current' && validAdmissionRecord(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }
    
    // 2. Analytics Collection
    match /analytics/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // 3. Notifications Collection
    match /notifications/{userId}/items/{notifId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // Announcements (Admin > Settings > Announcements). Signed-in students read
    // published ones only (queries must filter status == 'published'); writes go
    // through /api/admin/announcements.
    match /announcements/{announcementId} {
      allow get, list: if isAuthenticated() && resource.data.status == 'published';
      allow write: if false;
    }

    // 4. Configuration & Admins
    match /config/settings {
      allow read: if true; // All users need to read announcement banners, etc.
      allow write: if isAdmin(); 
    }
    
    // Terms/Privacy versions. Admins change them through /api/admin/legal.
    match /config/legal {
      allow read: if true;
      allow write: if false;
    }

    match /config/admins {
      allow read: if isAdmin(); // Only admins can read the admin list
      allow write: if false; // Only manageable directly via Firebase Console
    }
    
    // 5. Course Catalog
    match /courseCatalog/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); 
    }
    
    // 6. Share Codes
    match /shareCodes/{codeId} {
      // A signed-in user can fetch one code they know; nobody can list every code.
      // A code an admin has disabled (Admin > Share codes) can no longer be fetched.
      // A code that does not exist reads as "not found" (resource == null), not denied:
      // Android probes candidate codes before creating one, and both apps report unknown codes.
      allow get: if isAuthenticated() && (resource == null || resource.data.get('disabled', false) != true);
      // New codes stop while the admin has switched "share_code" off (admins always may).
      // A student can only create a code under their own uid.
      allow create: if isAdmin() || (isAuthenticated() && platformFeatureEnabled('share_code')
        && request.resource.data.get('authorId', '') == request.auth.uid);
      // Importing adds exactly one to the counter (both apps use increment(1)).
      allow update: if (isAuthenticated()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['useCount'])
          && request.resource.data.useCount == resource.data.get('useCount', 0) + 1)
        || isAdmin();
      allow delete: if isAdmin();
    }
    
    // 7. Shared Transcripts
    match /shared_transcripts/{docId} {
      allow read, delete: if isOwner(resource.data.uid);
    }

    // Server-only abuse-protection counters. Firebase Admin bypasses rules;
    // no browser or mobile client may inspect or modify its own quota state.
    match /_api_rate_limits/{docId} {
      allow read, write: if false;
    }

    // Reward grants, replay tombstones and daily budgets are server-owned.
    // Even admins/owners must use authenticated server routes, not client SDKs.
    match /_reward_sessions/{document=**} {
      allow read, write: if false;
    }
    match /_reward_transactions/{document=**} {
      allow read, write: if false;
    }
    match /_reward_daily/{document=**} {
      allow read, write: if false;
    }

    // Coin wallets, the append-only ledger and spend idempotency records are
    // server-owned. Clients never read or write balances directly.
    match /_coin_wallets/{document=**} {
      allow read, write: if false;
    }
    match /_coin_ledger/{document=**} {
      allow read, write: if false;
    }
    match /_coin_requests/{document=**} {
      allow read, write: if false;
    }

    // Registration tickets and normalized matric reservations are created and
    // consumed only by Firebase Admin inside server routes.
    match /_registration_tickets/{docId} {
      allow read, write: if false;
    }

    match /_matric_numbers/{docId} {
      allow read, write: if false;
    }

    // AI provider credentials, routing, and audit records are available only
    // through Firebase Admin in server routes. Client SDK callers are denied.
    match /_ai_runtime/{document=**} {
      allow read, write: if false;
    }

    match /_ai_secrets/{document=**} {
      allow read, write: if false;
    }

    match /_ai_audit/{document=**} {
      allow read, write: if false;
    }

    // Admin audit trail (lib/api/admin-audit.ts) and AI answer feedback/reports
    // (/api/ai/report). Read only through admin server routes.
    match /_admin_audit/{document=**} {
      allow read, write: if false;
    }

    match /_ai_feedback/{document=**} {
      allow read, write: if false;
    }

    // Result of the last "Verify login" for each email account (login address and source only).
    match /_email_status/{document=**} {
      allow read, write: if false;
    }

    // Terms and Privacy drafts and published versions (Admin > Legal documents).
    // The public pages read them through the server, never from a browser or the app.
    match /legal_documents/{document=**} {
      allow read, write: if false;
    }

    // Record of each daily clean-up run (/api/cron/daily). Read through the admin API only.
    match /_cron_runs/{document=**} {
      allow read, write: if false;
    }

    // Daily admin metrics roll-up (lib/admin/metrics.ts) and cron job cursors.
    // Aggregates only; read through /api/admin/stats.
    match /admin_metrics/{document=**} {
      allow read, write: if false;
    }

    match /_cron_state/{document=**} {
      allow read, write: if false;
    }

    // Each admin's monthly goodwill-coin allowance (Admin > Users > grant coins).
    match /_admin_grants/{document=**} {
      allow read, write: if false;
    }

    // Support requests. Students use /api/support/tickets; admins use /api/admin/support.
    match /support_tickets/{document=**} {
      allow read, write: if false;
    }

    // Gmail App Passwords are encrypted and managed only by server routes.
    match /_email_secrets/{document=**} {
      allow read, write: if false;
    }

    // Academic catalog suggestions are moderated through server routes only
    // (status pending, approved, merged, rejected, assigned or ignored).
    match /_academic_catalog_suggestions/{document=**} {
      allow read, write: if false;
    }

    // Admin "Assign" records with the undo data (uids and old values); server-only.
    match /_academic_catalog_assignments/{document=**} {
      allow read, write: if false;
    }

    // The managed catalogue (names and aliases). Clients read it through
    // /api/academic-catalog; admins change it through /api/admin/academic-catalog*.
    match /config/academicCatalog {
      allow read, write: if false;
    }

    // Unfinished account deletions, finished by the daily cron job (lib/cron/account-deletion.ts).
    // Holds the uid and email until the deletion completes; server-only.
    match /_account_deletion_queue/{document=**} {
      allow read, write: if false;
    }

    // Student testimonials (Admin > Testimonials). Public pages read approved quotes
    // through the server only (lib/testimonials/server.ts).
    match /public_testimonials/{document=**} {
      allow read, write: if false;
    }

    // Student-count threshold for the public site; written by /api/admin/testimonials.
    match /config/proof {
      allow read, write: if false;
    }
  }
}
